<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>HotelHRMS</RootNamespace>
    <AssemblyName>HotelHRMS</AssemblyName>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <MyType>WindowsForms</MyType>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="MainForm.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="MainForm.Designer.vb">
      <DependentUpon>MainForm.vb</DependentUpon>
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="Forms\EmployeeForm.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="Forms\EmployeeForm.Designer.vb">
      <DependentUpon>EmployeeForm.vb</DependentUpon>
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="Forms\AttendanceForm.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="Forms\AttendanceForm.Designer.vb">
      <DependentUpon>AttendanceForm.vb</DependentUpon>
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="Forms\PayrollForm.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="Forms\PayrollForm.Designer.vb">
      <DependentUpon>PayrollForm.vb</DependentUpon>
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="Forms\ReportViewerForm.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="Forms\ReportViewerForm.Designer.vb">
      <DependentUpon>ReportViewerForm.vb</DependentUpon>
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="Data\DatabaseContext.vb" />
    <Compile Include="Data\EmployeeRepository.vb" />
    <Compile Include="Data\AttendanceRepository.vb" />
    <Compile Include="Data\PayrollRepository.vb" />
    <Compile Include="Data\Models\Employee.vb" />
    <Compile Include="Data\Models\AttendanceRecord.vb" />
    <Compile Include="Data\Models\PayrollEntry.vb" />
    <Compile Include="Data\Models\PayPeriod.vb" />
    <Compile Include="Utilities\ValidationService.vb" />
    <Compile Include="Utilities\DialogService.vb" />
    <Compile Include="Utilities\CsvExportService.vb" />
    <Compile Include="Utilities\FormExtensions.vb" />
    <Compile Include="My Project\Application.Designer.vb">
      <AutoGen>True</AutoGen>
      <DependentUpon>Application.myapp</DependentUpon>
      <DesignTime>True</DesignTime>
    </Compile>
    <Compile Include="My Project\Application.vb">
      <DependentUpon>Application.myapp</DependentUpon>
    </Compile>
    <Compile Include="My Project\AssemblyInfo.vb" />
    <Compile Include="My Project\Resources.Designer.vb">
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
      <DesignTime>True</DesignTime>
    </Compile>
    <Compile Include="My Project\Settings.Designer.vb">
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="MainForm.resx">
      <DependentUpon>MainForm.vb</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Forms\EmployeeForm.resx">
      <DependentUpon>EmployeeForm.vb</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Forms\AttendanceForm.resx">
      <DependentUpon>AttendanceForm.vb</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Forms\PayrollForm.resx">
      <DependentUpon>PayrollForm.vb</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="Forms\ReportViewerForm.resx">
      <DependentUpon>ReportViewerForm.vb</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="My Project\Resources.resx">
      <Generator>VbMyResourcesResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.vb</LastGenOutput>
      <CustomToolNamespace>My.Resources</CustomToolNamespace>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Include="App.config" />
    <None Include="My Project\Application.myapp">
      <Generator>MyApplicationCodeGenerator</Generator>
      <LastGenOutput>Application.Designer.vb</LastGenOutput>
    </None>
    <None Include="My Project\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.vb</LastGenOutput>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.3.8" />
    <PackageReference Include="CsvHelper" Version="30.0.1" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
    <PackageReference Include="SAPCrystalReports.CrystalReportsEngine" Version="13.0.35" />
    <PackageReference Include="SAPCrystalReports.Viewer" Version="13.0.35" />
  </ItemGroup>

  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="Microsoft.VisualBasic" />
  </ItemGroup>

</Project>

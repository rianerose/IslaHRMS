<?xml version="1.0" encoding="utf-8"?>
<SettingsFile xmlns="http://schemas.microsoft.com/VisualStudio/2004/01/settings" CurrentProfile="(Default)" GeneratedClassNamespace="HotelHRMS.My" GeneratedClassName="MySettings">
  <Settings>
    <Setting Name="DefaultWorkDayHours" Type="System.Int32" Scope="Application">
      <Value Profile="(Default)">8</Value>
    </Setting>
    <Setting Name="DefaultOvertimeRate" Type="System.Decimal" Scope="Application">
      <Value Profile="(Default)">1.5</Value>
    </Setting>
    <Setting Name="PayrollReportOutputPath" Type="System.String" Scope="Application">
      <Value Profile="(Default)">%USERPROFILE%\Documents\HotelHRMS\PayrollReports</Value>
    </Setting>
    <Setting Name="LastConnectedServer" Type="System.String" Scope="User">
      <Value Profile="(Default)">localhost</Value>
    </Setting>
  </Settings>
</SettingsFile>
